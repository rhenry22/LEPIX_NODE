 868:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****     case DHCP_STATE_BOUND:
 869:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****     case DHCP_STATE_REBOOTING:
 870:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****       dhcp->tries = 0;
