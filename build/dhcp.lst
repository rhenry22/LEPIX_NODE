 264:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c **** /**
 265:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****  * Back-off the DHCP client (because of a received NAK response).
 266:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****  *
 267:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****  * Back-off the DHCP client because of a received NAK. Receiving a
 268:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****  * NAK means the client asked for something non-sensible, for
 269:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****  * example when it tries to renew a lease obtained on another network.
 270:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****  *
 271:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****  * We clear any existing set IP address and restart DHCP negotiation
 272:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****  * afresh (as per RFC2131 3.2.3).
 273:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****  *
 274:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****  * @param netif the netif under DHCP control
 275:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****  */
 276:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c **** static void
 277:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c **** dhcp_handle_nak(struct netif *netif)
 278:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c **** {
 279:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****   struct dhcp *dhcp = netif_dhcp_data(netif);
 280:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c **** 
 281:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****   LWIP_DEBUGF(DHCP_DEBUG | LWIP_DBG_TRACE, ("dhcp_handle_nak(netif=%p) %c%c%"U16_F"\n",
 282:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****               (void *)netif, netif->name[0], netif->name[1], (u16_t)netif->num));
 283:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****   /* Change to a defined state - set this before assigning the address
 284:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****      to ensure the callback can use dhcp_supplied_address() */
 285:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****   dhcp_set_state(dhcp, DHCP_STATE_BACKING_OFF);
 286:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****   /* remove IP address from interface (must no longer be used, as per RFC2131) */
 287:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****   netif_set_addr(netif, IP4_ADDR_ANY4, IP4_ADDR_ANY4, IP4_ADDR_ANY4);
 288:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****   /* We can immediately restart discovery */
 289:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c ****   dhcp_discover(netif);
 290:Middlewares/Third_Party/LwIP/src/core/ipv4/dhcp.c **** }
