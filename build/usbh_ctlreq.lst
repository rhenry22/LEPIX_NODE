 701:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       (void)osMessagePut(phost->os_event, phost->os_msg, 0U);
 702:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c **** #else
 703:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       (void)osMessageQueuePut(phost->os_event, &phost->os_msg, 0U, 0U);
 704:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c **** #endif
 705:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c **** #endif
 706:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       break;
 707:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c **** 
 708:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****     case CMD_WAIT:
 709:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       status = USBH_HandleControl(phost);
 710:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       if ((status == USBH_OK) || (status == USBH_NOT_SUPPORTED))
 711:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       {
 712:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****         /* Transaction completed, move control state to idle */
ARM GAS  /tmp/ccoUEE4u.s 			page 22


 713:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****         phost->RequestState = CMD_SEND;
 714:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****         phost->Control.state = CTRL_IDLE;
 715:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       }
 716:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       else if (status == USBH_FAIL)
 717:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       {
 718:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****         /* Failure Mode */
 719:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****         phost->RequestState = CMD_SEND;
 720:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       }
 721:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       else
 722:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       {
 723:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****         /* .. */
 724:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       }
 725:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c **** #if (USBH_USE_OS == 1U)
 726:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       phost->os_msg = (uint32_t)USBH_CONTROL_EVENT;
 727:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c **** #if (osCMSIS < 0x20000U)
 728:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       (void)osMessagePut(phost->os_event, phost->os_msg, 0U);
 729:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c **** #else
 730:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       (void)osMessageQueuePut(phost->os_event, &phost->os_msg, 0U, 0U);
 731:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c **** #endif
 732:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c **** #endif
 733:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       break;
 734:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c **** 
 735:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****     default:
 736:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****       break;
 737:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****   }
 738:Middlewares/ST/STM32_USB_Host_Library/Core/Src/usbh_ctlreq.c ****   return status;
