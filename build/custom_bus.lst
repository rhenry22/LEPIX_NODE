  88:Core/Src/custom_bus.c ****   * @brief  Initialize I2C HAL
  89:Core/Src/custom_bus.c ****   * @retval BSP status
  90:Core/Src/custom_bus.c ****   */
  91:Core/Src/custom_bus.c **** int32_t BSP_I2C1_Init(void)
  92:Core/Src/custom_bus.c **** {
  93:Core/Src/custom_bus.c **** 
  94:Core/Src/custom_bus.c ****   int32_t ret = BSP_ERROR_NONE;
  95:Core/Src/custom_bus.c **** 
  96:Core/Src/custom_bus.c ****   hi2c1.Instance  = I2C1;
  97:Core/Src/custom_bus.c **** 
  98:Core/Src/custom_bus.c ****   if(I2C1InitCounter++ == 0)
  99:Core/Src/custom_bus.c ****   {
 100:Core/Src/custom_bus.c ****     if (HAL_I2C_GetState(&hi2c1) == HAL_I2C_STATE_RESET)
 101:Core/Src/custom_bus.c ****     {
 102:Core/Src/custom_bus.c ****     #if (USE_HAL_I2C_REGISTER_CALLBACKS == 0U)
 103:Core/Src/custom_bus.c ****       /* Init the I2C Msp */
 104:Core/Src/custom_bus.c ****       I2C1_MspInit(&hi2c1);
 105:Core/Src/custom_bus.c ****     #else
 106:Core/Src/custom_bus.c ****       if(IsI2C1MspCbValid == 0U)
 107:Core/Src/custom_bus.c ****       {
 108:Core/Src/custom_bus.c ****         if(BSP_I2C1_RegisterDefaultMspCallbacks() != BSP_ERROR_NONE)
 109:Core/Src/custom_bus.c ****         {
 110:Core/Src/custom_bus.c ****           return BSP_ERROR_MSP_FAILURE;
 111:Core/Src/custom_bus.c ****         }
 112:Core/Src/custom_bus.c ****       }
 113:Core/Src/custom_bus.c ****     #endif
 114:Core/Src/custom_bus.c ****       if(ret == BSP_ERROR_NONE)
 115:Core/Src/custom_bus.c ****       {
 116:Core/Src/custom_bus.c ****         /* Init the I2C */
 117:Core/Src/custom_bus.c ****         if(MX_I2C1_Init(&hi2c1) != HAL_OK)
 118:Core/Src/custom_bus.c ****         {
 119:Core/Src/custom_bus.c ****           ret = BSP_ERROR_BUS_FAILURE;
 120:Core/Src/custom_bus.c ****         }
 121:Core/Src/custom_bus.c ****         else
 122:Core/Src/custom_bus.c ****         {
 123:Core/Src/custom_bus.c ****           ret = BSP_ERROR_NONE;
 124:Core/Src/custom_bus.c ****         }
 125:Core/Src/custom_bus.c ****       }
 126:Core/Src/custom_bus.c ****     }
 127:Core/Src/custom_bus.c ****   }
 128:Core/Src/custom_bus.c ****   return ret;
 129:Core/Src/custom_bus.c **** }
 130:Core/Src/custom_bus.c **** 
 131:Core/Src/custom_bus.c **** /**
 132:Core/Src/custom_bus.c ****   * @brief  DeInitialize I2C HAL.
 133:Core/Src/custom_bus.c ****   * @retval BSP status
 134:Core/Src/custom_bus.c ****   */
 135:Core/Src/custom_bus.c **** int32_t BSP_I2C1_DeInit(void)
 136:Core/Src/custom_bus.c **** {
 137:Core/Src/custom_bus.c ****   int32_t ret = BSP_ERROR_NONE;
 138:Core/Src/custom_bus.c **** 
 139:Core/Src/custom_bus.c ****   if (I2C1InitCounter > 0)
