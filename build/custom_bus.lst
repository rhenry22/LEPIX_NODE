 142:Core/Src/custom_bus.c ****     {
 143:Core/Src/custom_bus.c ****   #if (USE_HAL_I2C_REGISTER_CALLBACKS == 0U)
 144:Core/Src/custom_bus.c ****       /* DeInit the I2C */
ARM GAS  /tmp/cchxAeZL.s 			page 4


 145:Core/Src/custom_bus.c ****       I2C1_MspDeInit(&hi2c1);
 146:Core/Src/custom_bus.c ****   #endif
 147:Core/Src/custom_bus.c ****       /* DeInit the I2C */
 148:Core/Src/custom_bus.c ****       if (HAL_I2C_DeInit(&hi2c1) != HAL_OK)
 149:Core/Src/custom_bus.c ****       {
 150:Core/Src/custom_bus.c ****         ret = BSP_ERROR_BUS_FAILURE;
 151:Core/Src/custom_bus.c ****       }
 152:Core/Src/custom_bus.c ****     }
 153:Core/Src/custom_bus.c ****   }
 154:Core/Src/custom_bus.c ****   return ret;
 155:Core/Src/custom_bus.c **** }
