 226:LWIP/Target/ethernetif.c **** /**
 227:LWIP/Target/ethernetif.c ****  * @brief This function should do the actual transmission of the packet. The packet is
 228:LWIP/Target/ethernetif.c ****  * contained in the pbuf that is passed to the function. This pbuf
 229:LWIP/Target/ethernetif.c ****  * might be chained.
 230:LWIP/Target/ethernetif.c ****  *
 231:LWIP/Target/ethernetif.c ****  * @param netif the lwip network interface structure for this ethernetif
 232:LWIP/Target/ethernetif.c ****  * @param p the MAC packet to send (e.g. IP packet including MAC addresses and type)
 233:LWIP/Target/ethernetif.c ****  * @return ERR_OK if the packet could be sent
 234:LWIP/Target/ethernetif.c ****  *         an err_t value if the packet couldn't be sent
 235:LWIP/Target/ethernetif.c ****  *
 236:LWIP/Target/ethernetif.c ****  * @note Returning ERR_MEM here if a DMA queue of your MAC is full can lead to
 237:LWIP/Target/ethernetif.c ****  *       strange results. You might consider waiting for space in the DMA queue
 238:LWIP/Target/ethernetif.c ****  *       to become available since the stack doesn't retry to send a packet
 239:LWIP/Target/ethernetif.c ****  *       dropped because of memory failure (except for the TCP timers).
 240:LWIP/Target/ethernetif.c ****  */
 241:LWIP/Target/ethernetif.c **** 
 242:LWIP/Target/ethernetif.c **** static err_t low_level_output(struct netif *netif, struct pbuf *p)
 243:LWIP/Target/ethernetif.c **** {
 244:LWIP/Target/ethernetif.c ****   uint32_t i = 0U;
 245:LWIP/Target/ethernetif.c ****   struct pbuf *q = NULL;
 246:LWIP/Target/ethernetif.c ****   err_t errval = ERR_OK;
 247:LWIP/Target/ethernetif.c ****   ETH_BufferTypeDef Txbuffer[ETH_TX_DESC_CNT] = {0};
 248:LWIP/Target/ethernetif.c **** 
 249:LWIP/Target/ethernetif.c ****   memset(Txbuffer, 0 , ETH_TX_DESC_CNT*sizeof(ETH_BufferTypeDef));
 250:LWIP/Target/ethernetif.c **** 
 251:LWIP/Target/ethernetif.c ****   for(q = p; q != NULL; q = q->next)
 252:LWIP/Target/ethernetif.c ****   {
 253:LWIP/Target/ethernetif.c ****     if(i >= ETH_TX_DESC_CNT)
 254:LWIP/Target/ethernetif.c ****       return ERR_IF;
 255:LWIP/Target/ethernetif.c **** 
 256:LWIP/Target/ethernetif.c ****     Txbuffer[i].buffer = q->payload;
 257:LWIP/Target/ethernetif.c ****     Txbuffer[i].len = q->len;
 258:LWIP/Target/ethernetif.c **** 
ARM GAS  /tmp/ccyhlr5S.s 			page 6


 259:LWIP/Target/ethernetif.c ****     if(i>0)
 260:LWIP/Target/ethernetif.c ****     {
 261:LWIP/Target/ethernetif.c ****       Txbuffer[i-1].next = &Txbuffer[i];
 262:LWIP/Target/ethernetif.c ****     }
 263:LWIP/Target/ethernetif.c **** 
 264:LWIP/Target/ethernetif.c ****     if(q->next == NULL)
 265:LWIP/Target/ethernetif.c ****     {
 266:LWIP/Target/ethernetif.c ****       Txbuffer[i].next = NULL;
 267:LWIP/Target/ethernetif.c ****     }
 268:LWIP/Target/ethernetif.c **** 
 269:LWIP/Target/ethernetif.c ****     i++;
 270:LWIP/Target/ethernetif.c ****   }
 271:LWIP/Target/ethernetif.c **** 
 272:LWIP/Target/ethernetif.c ****   TxConfig.Length = p->tot_len;
 273:LWIP/Target/ethernetif.c ****   TxConfig.TxBuffer = Txbuffer;
 274:LWIP/Target/ethernetif.c ****   TxConfig.pData = p;
 275:LWIP/Target/ethernetif.c **** 
 276:LWIP/Target/ethernetif.c ****   HAL_ETH_Transmit(&heth, &TxConfig, ETH_DMA_TRANSMIT_TIMEOUT);
 277:LWIP/Target/ethernetif.c **** 
 278:LWIP/Target/ethernetif.c ****   return errval;
 279:LWIP/Target/ethernetif.c **** }
 280:LWIP/Target/ethernetif.c **** 
 281:LWIP/Target/ethernetif.c **** /**
 282:LWIP/Target/ethernetif.c ****  * @brief Should allocate a pbuf and transfer the bytes of the incoming
 283:LWIP/Target/ethernetif.c ****  * packet from the interface into the pbuf.
 284:LWIP/Target/ethernetif.c ****  *
 285:LWIP/Target/ethernetif.c ****  * @param netif the lwip network interface structure for this ethernetif
 286:LWIP/Target/ethernetif.c ****  * @return a pbuf filled with the received packet (including MAC header)
 287:LWIP/Target/ethernetif.c ****  *         NULL on memory error
 288:LWIP/Target/ethernetif.c ****    */
 289:LWIP/Target/ethernetif.c **** static struct pbuf * low_level_input(struct netif *netif)
 290:LWIP/Target/ethernetif.c **** {
 291:LWIP/Target/ethernetif.c ****   struct pbuf *p = NULL;
 292:LWIP/Target/ethernetif.c **** 
 293:LWIP/Target/ethernetif.c ****   if(RxAllocStatus == RX_ALLOC_OK)
 294:LWIP/Target/ethernetif.c ****   {
 295:LWIP/Target/ethernetif.c ****     HAL_ETH_ReadData(&heth, (void **)&p);
 296:LWIP/Target/ethernetif.c ****   }
 297:LWIP/Target/ethernetif.c **** 
 298:LWIP/Target/ethernetif.c ****   return p;
 299:LWIP/Target/ethernetif.c **** }
 300:LWIP/Target/ethernetif.c **** 
 301:LWIP/Target/ethernetif.c **** /**
 302:LWIP/Target/ethernetif.c ****  * @brief This function should be called when a packet is ready to be read
 303:LWIP/Target/ethernetif.c ****  * from the interface. It uses the function low_level_input() that
 304:LWIP/Target/ethernetif.c ****  * should handle the actual reception of bytes from the network
 305:LWIP/Target/ethernetif.c ****  * interface. Then the type of the received packet is determined and
 306:LWIP/Target/ethernetif.c ****  * the appropriate input function is called.
 307:LWIP/Target/ethernetif.c ****  *
 308:LWIP/Target/ethernetif.c ****  * @param netif the lwip network interface structure for this ethernetif
 309:LWIP/Target/ethernetif.c ****  */
 310:LWIP/Target/ethernetif.c **** void ethernetif_input(struct netif *netif)
 311:LWIP/Target/ethernetif.c **** {
 312:LWIP/Target/ethernetif.c ****   struct pbuf *p = NULL;
 313:LWIP/Target/ethernetif.c **** 
 314:LWIP/Target/ethernetif.c ****   do
