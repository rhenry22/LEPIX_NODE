 259:USB_DEVICE/App/usbd_cdc_if.c **** /**
 260:USB_DEVICE/App/usbd_cdc_if.c ****   * @brief  Data received over USB OUT endpoint are sent over CDC interface
 261:USB_DEVICE/App/usbd_cdc_if.c ****   *         through this function.
 262:USB_DEVICE/App/usbd_cdc_if.c ****   *
 263:USB_DEVICE/App/usbd_cdc_if.c ****   *         @note
 264:USB_DEVICE/App/usbd_cdc_if.c ****   *         This function will issue a NAK packet on any OUT packet received on
 265:USB_DEVICE/App/usbd_cdc_if.c ****   *         USB endpoint until exiting this function. If you exit this function
 266:USB_DEVICE/App/usbd_cdc_if.c ****   *         before transfer is complete on CDC interface (ie. using DMA controller)
 267:USB_DEVICE/App/usbd_cdc_if.c ****   *         it will result in receiving more data while previous ones are still
 268:USB_DEVICE/App/usbd_cdc_if.c ****   *         not sent.
 269:USB_DEVICE/App/usbd_cdc_if.c ****   *
 270:USB_DEVICE/App/usbd_cdc_if.c ****   * @param  Buf: Buffer of data to be received
 271:USB_DEVICE/App/usbd_cdc_if.c ****   * @param  Len: Number of data received (in bytes)
 272:USB_DEVICE/App/usbd_cdc_if.c ****   * @retval Result of the operation: USBD_OK if all operations are OK else USBD_FAIL
 273:USB_DEVICE/App/usbd_cdc_if.c ****   */
 274:USB_DEVICE/App/usbd_cdc_if.c **** static int8_t CDC_Receive_FS(uint8_t* Buf, uint32_t *Len)
 275:USB_DEVICE/App/usbd_cdc_if.c **** {
 276:USB_DEVICE/App/usbd_cdc_if.c ****   /* USER CODE BEGIN 6 */
 277:USB_DEVICE/App/usbd_cdc_if.c ****   USBD_CDC_SetRxBuffer(&hUsbDeviceFS, &Buf[0]);
 278:USB_DEVICE/App/usbd_cdc_if.c ****   USBD_CDC_ReceivePacket(&hUsbDeviceFS);
 279:USB_DEVICE/App/usbd_cdc_if.c ****   return (USBD_OK);
 280:USB_DEVICE/App/usbd_cdc_if.c ****   /* USER CODE END 6 */
 281:USB_DEVICE/App/usbd_cdc_if.c **** }
 282:USB_DEVICE/App/usbd_cdc_if.c **** 
 283:USB_DEVICE/App/usbd_cdc_if.c **** /**
 284:USB_DEVICE/App/usbd_cdc_if.c ****   * @brief  CDC_Transmit_FS
 285:USB_DEVICE/App/usbd_cdc_if.c ****   *         Data to send over USB IN endpoint are sent over CDC interface
ARM GAS  /tmp/ccib15js.s 			page 8


 286:USB_DEVICE/App/usbd_cdc_if.c ****   *         through this function.
 287:USB_DEVICE/App/usbd_cdc_if.c ****   *         @note
 288:USB_DEVICE/App/usbd_cdc_if.c ****   *
 289:USB_DEVICE/App/usbd_cdc_if.c ****   *
 290:USB_DEVICE/App/usbd_cdc_if.c ****   * @param  Buf: Buffer of data to be sent
 291:USB_DEVICE/App/usbd_cdc_if.c ****   * @param  Len: Number of data to be sent (in bytes)
 292:USB_DEVICE/App/usbd_cdc_if.c ****   * @retval USBD_OK if all operations are OK else USBD_FAIL or USBD_BUSY
 293:USB_DEVICE/App/usbd_cdc_if.c ****   */
 294:USB_DEVICE/App/usbd_cdc_if.c **** uint8_t CDC_Transmit_FS(uint8_t* Buf, uint16_t Len)
 295:USB_DEVICE/App/usbd_cdc_if.c **** {
 296:USB_DEVICE/App/usbd_cdc_if.c ****   uint8_t result = USBD_OK;
 297:USB_DEVICE/App/usbd_cdc_if.c ****   /* USER CODE BEGIN 7 */
 298:USB_DEVICE/App/usbd_cdc_if.c ****   USBD_CDC_HandleTypeDef *hcdc = (USBD_CDC_HandleTypeDef*)hUsbDeviceFS.pClassData;
 299:USB_DEVICE/App/usbd_cdc_if.c ****   if (hcdc->TxState != 0){
 300:USB_DEVICE/App/usbd_cdc_if.c ****     return USBD_BUSY;
 301:USB_DEVICE/App/usbd_cdc_if.c ****   }
 302:USB_DEVICE/App/usbd_cdc_if.c ****   USBD_CDC_SetTxBuffer(&hUsbDeviceFS, Buf, Len);
 303:USB_DEVICE/App/usbd_cdc_if.c ****   result = USBD_CDC_TransmitPacket(&hUsbDeviceFS);
 304:USB_DEVICE/App/usbd_cdc_if.c ****   /* USER CODE END 7 */
 305:USB_DEVICE/App/usbd_cdc_if.c ****   return result;
 306:USB_DEVICE/App/usbd_cdc_if.c **** }
