 170:FATFS/Target/usbh_diskio.c **** /**
 171:FATFS/Target/usbh_diskio.c ****   * @brief  Writes Sector(s)
 172:FATFS/Target/usbh_diskio.c ****   * @param  lun : lun id
 173:FATFS/Target/usbh_diskio.c ****   * @param  *buff: Data to be written
 174:FATFS/Target/usbh_diskio.c ****   * @param  sector: Sector address (LBA)
 175:FATFS/Target/usbh_diskio.c ****   * @param  count: Number of sectors to write (1..128)
 176:FATFS/Target/usbh_diskio.c ****   * @retval DRESULT: Operation result
 177:FATFS/Target/usbh_diskio.c ****   */
 178:FATFS/Target/usbh_diskio.c **** #if _USE_WRITE == 1
 179:FATFS/Target/usbh_diskio.c **** DRESULT USBH_write(BYTE lun, const BYTE *buff, DWORD sector, UINT count)
 180:FATFS/Target/usbh_diskio.c **** {
 181:FATFS/Target/usbh_diskio.c ****   DRESULT res = RES_ERROR;
 182:FATFS/Target/usbh_diskio.c ****   MSC_LUNTypeDef info;
 183:FATFS/Target/usbh_diskio.c ****   USBH_StatusTypeDef  status = USBH_OK;
 184:FATFS/Target/usbh_diskio.c **** 
 185:FATFS/Target/usbh_diskio.c ****   if (((DWORD)buff & 3) && (((HCD_HandleTypeDef *)hUSB_Host.pData)->Init.dma_enable))
 186:FATFS/Target/usbh_diskio.c ****   {
 187:FATFS/Target/usbh_diskio.c **** 
 188:FATFS/Target/usbh_diskio.c ****     while (count--)
 189:FATFS/Target/usbh_diskio.c ****     {
 190:FATFS/Target/usbh_diskio.c ****       memcpy (scratch, &buff[count * _MAX_SS], _MAX_SS);
 191:FATFS/Target/usbh_diskio.c **** 
 192:FATFS/Target/usbh_diskio.c ****       status = USBH_MSC_Write(&hUSB_Host, lun, sector + count, (BYTE *)scratch, 1) ;
 193:FATFS/Target/usbh_diskio.c ****       if(status == USBH_FAIL)
 194:FATFS/Target/usbh_diskio.c ****       {
 195:FATFS/Target/usbh_diskio.c ****         break;
 196:FATFS/Target/usbh_diskio.c ****       }
 197:FATFS/Target/usbh_diskio.c ****     }
 198:FATFS/Target/usbh_diskio.c ****   }
 199:FATFS/Target/usbh_diskio.c ****   else
 200:FATFS/Target/usbh_diskio.c ****   {
 201:FATFS/Target/usbh_diskio.c ****     status = USBH_MSC_Write(&hUSB_Host, lun, sector, (BYTE *)buff, count);
 202:FATFS/Target/usbh_diskio.c ****   }
 203:FATFS/Target/usbh_diskio.c **** 
 204:FATFS/Target/usbh_diskio.c ****   if(status == USBH_OK)
 205:FATFS/Target/usbh_diskio.c ****   {
 206:FATFS/Target/usbh_diskio.c ****     res = RES_OK;
 207:FATFS/Target/usbh_diskio.c ****   }
 208:FATFS/Target/usbh_diskio.c ****   else
 209:FATFS/Target/usbh_diskio.c ****   {
 210:FATFS/Target/usbh_diskio.c ****     USBH_MSC_GetLUNInfo(&hUSB_Host, lun, &info);
 211:FATFS/Target/usbh_diskio.c **** 
 212:FATFS/Target/usbh_diskio.c ****     switch (info.sense.asc)
 213:FATFS/Target/usbh_diskio.c ****     {
 214:FATFS/Target/usbh_diskio.c ****     case SCSI_ASC_WRITE_PROTECTED:
ARM GAS  /tmp/cc6xNi5E.s 			page 10


 215:FATFS/Target/usbh_diskio.c ****       USBH_ErrLog("USB Disk is Write protected!");
 216:FATFS/Target/usbh_diskio.c ****       res = RES_WRPRT;
 217:FATFS/Target/usbh_diskio.c ****       break;
 218:FATFS/Target/usbh_diskio.c **** 
 219:FATFS/Target/usbh_diskio.c ****     case SCSI_ASC_LOGICAL_UNIT_NOT_READY:
 220:FATFS/Target/usbh_diskio.c ****     case SCSI_ASC_MEDIUM_NOT_PRESENT:
 221:FATFS/Target/usbh_diskio.c ****     case SCSI_ASC_NOT_READY_TO_READY_CHANGE:
 222:FATFS/Target/usbh_diskio.c ****       USBH_ErrLog("USB Disk is not ready!");
 223:FATFS/Target/usbh_diskio.c ****       res = RES_NOTRDY;
 224:FATFS/Target/usbh_diskio.c ****       break;
 225:FATFS/Target/usbh_diskio.c **** 
