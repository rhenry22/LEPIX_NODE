  56:LWIP/App/lwip.c **** /**
  57:LWIP/App/lwip.c ****   * LwIP initialization function
  58:LWIP/App/lwip.c ****   */
  59:LWIP/App/lwip.c **** void MX_LWIP_Init(void)
  60:LWIP/App/lwip.c **** {
  61:LWIP/App/lwip.c ****   /* Initilialize the LwIP stack without RTOS */
  62:LWIP/App/lwip.c ****   lwip_init();
  63:LWIP/App/lwip.c **** 
  64:LWIP/App/lwip.c ****   /* --- CONFIGURATION IP STATIQUE 2.2.2.2 --- */
  65:LWIP/App/lwip.c ****   IP4_ADDR(&ipaddr, 2, 2, 2, 2);
  66:LWIP/App/lwip.c ****   IP4_ADDR(&netmask, 255, 0, 0, 0);
  67:LWIP/App/lwip.c ****   IP4_ADDR(&gw, 2, 2, 2, 1);
  68:LWIP/App/lwip.c **** 
  69:LWIP/App/lwip.c ****   /* add the network interface (IPv4/IPv6) without RTOS */
  70:LWIP/App/lwip.c ****   netif_add(&gnetif, &ipaddr, &netmask, &gw, NULL, &ethernetif_init, &ethernet_input);
  71:LWIP/App/lwip.c **** 
  72:LWIP/App/lwip.c ****   /* Registers the default network interface */
  73:LWIP/App/lwip.c ****   netif_set_default(&gnetif);
  74:LWIP/App/lwip.c **** 
  75:LWIP/App/lwip.c ****   if (netif_is_link_up(&gnetif))
  76:LWIP/App/lwip.c ****   {
  77:LWIP/App/lwip.c ****     /* When the netif is fully configured this function must be called */
  78:LWIP/App/lwip.c ****     netif_set_up(&gnetif);
  79:LWIP/App/lwip.c ****   }
  80:LWIP/App/lwip.c ****   else
  81:LWIP/App/lwip.c ****   {
  82:LWIP/App/lwip.c ****     /* When the netif link is down this function must be called */
  83:LWIP/App/lwip.c ****     netif_set_down(&gnetif);
  84:LWIP/App/lwip.c ****   }
  85:LWIP/App/lwip.c **** 
  86:LWIP/App/lwip.c ****   /* Set the link callback function, this function is called on change of link status*/
  87:LWIP/App/lwip.c ****   netif_set_link_callback(&gnetif, ethernet_link_status_updated);
