  50:Core/Src/artnet.c **** /* ------------------------------------------------------------------ */
  51:Core/Src/artnet.c **** /*  Structure paquet Art-Net OpDmx (simplifié)                         */
  52:Core/Src/artnet.c **** /* ------------------------------------------------------------------ */
  53:Core/Src/artnet.c **** typedef struct __attribute__((packed)) {
  54:Core/Src/artnet.c ****     char     id[8];          /* "Art-Net\0"                */
  55:Core/Src/artnet.c ****     uint16_t opcode;         /* 0x0050 little-endian       */
  56:Core/Src/artnet.c ****     uint8_t  prot_hi;        /* Protocol version Hi = 0    */
  57:Core/Src/artnet.c ****     uint8_t  prot_lo;        /* Protocol version Lo = 14   */
  58:Core/Src/artnet.c ****     uint8_t  sequence;       /* 0 = désactivé              */
  59:Core/Src/artnet.c ****     uint8_t  physical;       /* Port physique source        */
  60:Core/Src/artnet.c ****     uint8_t  sub_uni;        /* Universe (bits 0-3)        */
  61:Core/Src/artnet.c ****     uint8_t  net;            /* Net (bits 8-14)            */
  62:Core/Src/artnet.c ****     uint16_t length;         /* Longueur DMX (big-endian)  */
  63:Core/Src/artnet.c ****     uint8_t  data[ARTNET_DMX_CHANNELS];
  64:Core/Src/artnet.c **** } ArtDmx_t;
  65:Core/Src/artnet.c **** 
